# Copy to .env and fill in. Never commit .env.

# Shared admin token for the demo. Any long random string of letters and digits
# (hex is fine). No spaces, quotes, $ or #: `make dev` reads this file as shell.
ADMIN_TOKEN=

# Only needed for the live assistant and `make evals`. Tests and `make check` do not use it.
ANTHROPIC_API_KEY=
# Check Anthropic's docs for the current model id before first use.
ANTHROPIC_MODEL=

# Which event source to load: file (default) or mixpanel.
EVENT_SOURCE=file

# Only for EVENT_SOURCE=mixpanel and `make mixpanel-push`. Use a Mixpanel project that
# holds nothing else. Region is us (default), eu or in. MIXPANEL_AS_OF is the day the
# data runs up to (2026-10-30 for the seeded workspace).
MIXPANEL_PROJECT_ID=
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
MIXPANEL_REGION=
MIXPANEL_AS_OF=

# Ask endpoint protection.
ASK_RATE_PER_MINUTE=5
ASK_DAILY_BUDGET_USD=2

# Frontend origin allowed by CORS, and where the frontend finds the backend.
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000
